{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickQR",
  "version": "0.3.0",
  "identifier": "dev.QuickQR.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "QuickQR", "width": 1200, "height": 860, "minWidth": 420, "minHeight": 640, "backgroundColor": "#EEF0F3", "theme": null }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Styled QR codes from text or URLs",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
