{
  "name": "QuickQR",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "dev": "npm run icons && vite",
    "build": "npm run icons && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "npm run icons && vitest run",
    "tauri": "tauri",
    "prepare": "husky",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test",
    "setup": "husky",
    "version": "node scripts/version-changelog.mjs && node scripts/version-bump.mjs && git add CHANGELOG.md src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "postversion": "node scripts/version-tag.mjs",
    "version-patch": "npm version patch --ignore-scripts=false",
    "version-minor": "npm version minor --ignore-scripts=false",
    "version-major": "npm version major --ignore-scripts=false"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "@xmldom/xmldom": "0.9.12",
    "husky": "9.1.7",
    "lucide-static": "1.63.0",
    "typescript": "7.0.2",
    "uqr": "0.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "2.8.4",
    "@tauri-apps/plugin-fs": "2.7.1"
  }
}
